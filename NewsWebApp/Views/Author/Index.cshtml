@model IEnumerable<NewsWebApp.Models.Author>
@{
    ViewData["Title"] = "Authors";
}

<h1>Authors</h1>

<p>
    Meet our editorial team, investigative journalists, and correspondents.
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Photo</th>
            <th>Name</th>
            <th>Bio</th>
            <th>Articles</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width: 60px;">
                    <img src="@(string.IsNullOrEmpty(item.ProfileImageUrl) ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" : item.ProfileImageUrl)"
                         alt="@item.DisplayName"
                         class="rounded-circle" style="width: 45px; height: 45px; object-fit: cover;" />
                </td>
                <td>
                    <strong>@item.DisplayName</strong>
                </td>
                <td>
                    @(item.Bio ?? "Staff correspondent.")
                </td>
                <td>
                    <span class="badge bg-secondary">@item.NewsArticles.Count</span>
                </td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
