@model NewsWebApp.ViewModels.CategoryViewModel
@{
    ViewData["Title"] = "Create Category";
}

<h1>Create</h1>

<partial name="_AdminNav" />

<h4>Category</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Admin" asp-action="CreateCategory" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Slug" class="control-label">Slug (Optional)</label>
                <input asp-for="Slug" class="form-control" placeholder="auto-generated-if-blank" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Categories">Back to List</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
