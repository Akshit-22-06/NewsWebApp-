<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NewsBase</title>
    <!-- Editorial Typography Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..800;1,6..72,400..800&family=Source+Sans+3:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Top Editorial Utility Bar -->
        <div class="site-masthead-bar py-1 d-none d-md-block">
            <div class="container d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-uppercase fw-semibold me-3">@DateTime.UtcNow.ToString("dddd, MMMM dd, yyyy")</span>
                    <span class="text-muted">Global Edition</span>
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="About" class="text-decoration-none text-muted small">About</a>
                    <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted small">Privacy</a>
                    <a asp-controller="Home" asp-action="Terms" class="text-decoration-none text-muted small">Terms</a>
                </div>
            </div>
        </div>

        <!-- Newspaper Masthead -->
        <div class="site-masthead text-center">
            <div class="container">
                <a asp-controller="Home" asp-action="Index" class="site-brand-logo d-inline-block">NEWSBASE</a>
                <div class="site-tagline">Independent Journalism &bull; Daily Global Wire</div>
            </div>
        </div>

        <!-- Main & Category Navigation -->
        <nav class="navbar navbar-expand-lg editorial-navbar">
            <div class="container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Front Page</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Index">All Stories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Category" asp-route-slug="technology">Technology</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Category" asp-route-slug="business">Business</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Category" asp-route-slug="science">Science</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Author" asp-action="Index">Journalists</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="News" asp-action="Bookmarks">Reading List</a>
                            </li>
                        }
                        @if (User.IsInRole("Author"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold" asp-controller="Author" asp-action="Dashboard">Author Studio</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-controller="Admin" asp-action="Index">Editorial Admin</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-1" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-1" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show rounded-1" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>@TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Authentic Newspaper Footer -->
    <footer class="editorial-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="editorial-footer-heading">About NewsBase</h5>
                    <p class="small text-muted mb-2">
                        NewsBase is an independent news publication delivering factual reporting, rigorous analysis, and global news feeds. Powered by ethical editorial standards and Google Gemini automated moderation.
                    </p>
                    <p class="small text-muted mb-0">
                        Published daily with international news wire feeds and original investigative dispatches.
                    </p>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h5 class="editorial-footer-heading">Sections</h5>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><a asp-controller="News" asp-action="Category" asp-route-slug="technology">Technology</a></li>
                        <li class="mb-1"><a asp-controller="News" asp-action="Category" asp-route-slug="business">Business</a></li>
                        <li class="mb-1"><a asp-controller="News" asp-action="Category" asp-route-slug="science">Science</a></li>
                        <li class="mb-1"><a asp-controller="News" asp-action="Category" asp-route-slug="health">Health</a></li>
                        <li class="mb-1"><a asp-controller="News" asp-action="Category" asp-route-slug="politics">Politics</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h5 class="editorial-footer-heading">Journalism</h5>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><a asp-controller="Author" asp-action="Index">Correspondents</a></li>
                        <li class="mb-1"><a asp-controller="News" asp-action="Index">Global Wire</a></li>
                        <li class="mb-1"><a asp-controller="Home" asp-action="About">Editorial Standards</a></li>
                        <li class="mb-1"><a asp-controller="Account" asp-action="Register">Become an Author</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h5 class="editorial-footer-heading">Daily Briefing</h5>
                    <p class="small text-muted mb-2">Subscribe to our morning dispatch of essential stories.</p>
                    <form asp-controller="Home" asp-action="Subscribe" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="/" />
                        <div class="input-group input-group-sm">
                            <input type="email" name="email" class="form-control" placeholder="Enter your email" required />
                            <button class="btn btn-editorial-primary" type="submit">Subscribe</button>
                        </div>
                    </form>
                    <div class="small text-muted">
                        <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a> &bull;
                        <a asp-controller="Home" asp-action="Terms">Terms of Service</a>
                    </div>
                </div>
            </div>
            <div class="pt-3 border-top border-secondary-subtle d-flex flex-wrap justify-content-between align-items-center small text-muted">
                <div>&copy; @DateTime.UtcNow.Year NewsBase Publishing Group. All rights reserved.</div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a asp-controller="Home" asp-action="Terms">Terms</a>
                    <a asp-controller="Home" asp-action="About">About</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
