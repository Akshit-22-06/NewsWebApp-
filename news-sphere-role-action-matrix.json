  "cards": [
    {
      "dot": "cyan",
      "title": "Authentication & Authorization Model",
      "items": [
        "Cookie authentication manages user identity across 14-day persistent sliding sessions",
        "Role-based authorization ([Authorize(Roles = 'Admin,Author')]) restricts access to controller actions",
        "Internal resource ownership guards compare article/comment author ID with ClaimsPrincipal.FindFirst(NameIdentifier)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Layered Request Flow Execution",
      "items": [
        "Anonymous traffic passes directly to HomeController, CategoryController, AuthorController, and public News actions",
        "Authenticated actions verify session cookies before dispatching to NewsController (bookmarks/comments) or AdminController",
        "Ownership validations return 403 Forbidden if non-admin authors attempt modifying another journalist's articles"
      ]
    },
    {
      "dot": "violet",
      "title": "Repository Pattern & Data Decoupling",
      "items": [
        "Controllers inject scoped repository abstractions (INewsRepository, ICategoryRepository, etc.) via DI container",
        "EF Core change tracking is disabled (AsNoTracking) on public read queries for high throughput",
        "Identity services (UserManager & RoleManager) isolate user credentials and role claims from presentation views"
      ]
    }
  ]
