  "cards": [
    {
      "dot": "cyan",
      "title": "Dependency Injection Contract",
      "items": [
        "Controllers inject repository interfaces (INewsRepository, IAuthorRepository, etc.)",
        "Repositories are registered with Scoped lifetime in Program.cs",
        "LiveNewsService is injected into background tasks via IServiceScopeFactory"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data Context & Entity Sets",
      "items": [
        "ApplicationDbContext inherits IdentityDbContext<ApplicationUser>",
        "Configures fluent relationships, unique slug indices, and cascade rules in OnModelCreating",
        "Supports dynamic provider switching between SQLite and SQL Server"
      ]
    },
    {
      "dot": "violet",
      "title": "Decoupled Clean Architecture",
      "items": [
        "Views bind strictly to ViewModels rather than raw database entities",
        "Repositories isolate async EF Core queries and projection logic",
        "Background poller runs asynchronously without blocking HTTP request pipelines"
      ]
    }
  ]
