{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=newswebapp.db"
  },
  "CurrentsApi": {
    "BaseUrl": "https://api.currentsapi.services/",
    "ApiKey": ""
  },
  "Gemini": {
    "Model": "gemini-3.6-flash",
    "FallbackModels": [
      "gemini-3.5-flash",
      "gemini-3.5-flash-lite",
      "gemini-3.1-flash-lite",
      "gemini-flash-latest"
    ],
    "TimeoutSeconds": 45,
    "MinimumQualityScore": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}