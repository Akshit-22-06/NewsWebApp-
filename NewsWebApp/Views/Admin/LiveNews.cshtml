@model NewsWebApp.ViewModels.LiveNewsHubViewModel
@{
    ViewData["Title"] = "Live News Hub";
}

<h1>Live News Hub</h1>

<p class="text-muted">
    Multi-provider live news ingestion from Worldwide APIs, Indian National feeds, State/City-wise local dispatches, and Hacker News REST API.
</p>

<partial name="_AdminNav" />

<!-- Status Metrics Cards -->
<div class="row row-cols-1 row-cols-md-4 g-3 mb-4">
    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <h3 class="card-title text-primary">@Model.TotalLiveArticles</h3>
                <p class="card-text text-muted small">Live Ingested Stories</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <h3 class="card-title">@Model.TotalArticles</h3>
                <p class="card-text text-muted small">Total Platform Stories</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <h3 class="card-title @(Model.IsAutoSyncEnabled ? "text-success" : "text-warning")">
                    @(Model.IsAutoSyncEnabled ? "ACTIVE" : "PAUSED")
                </h3>
                <p class="card-text text-muted small">Background Poller</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <h3 class="card-title">@Model.SyncIntervalMinutes min</h3>
                <p class="card-text text-muted small">Auto-Poll Frequency</p>
            </div>
        </div>
    </div>
</div>

<!-- News API Providers & Geographic Hub Actions -->
<h4>News API Providers &amp; Geographic Actions</h4>
<div class="row row-cols-1 row-cols-md-4 g-3 mb-4">
    <!-- 1. All Feeds Sync -->
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">Sync All Feeds</h5>
                    <span class="badge bg-primary">All Active</span>
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    Polls all configured Worldwide, Indian National, and State/City local news sources in one click.
                </p>
                <form asp-controller="Admin" asp-action="SyncLiveNews" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        Sync All Feeds
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. Indian National News -->
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">🇮🇳 India National</h5>
                    <span class="badge bg-success">India Feeds</span>
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    Ingests top national headlines from The Hindu National and Times of India.
                </p>
                <form asp-controller="Admin" asp-action="SyncIndianNews" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-sm w-100">
                        Sync India National
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- 3. State & City Local Feeds -->
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">🏛️ State &amp; City News</h5>
                    <span class="badge bg-info text-dark">Local / Cities</span>
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    Ingests district &amp; city dispatches for Delhi NCR, Mumbai, Bengaluru, Chennai, Hyderabad, and Kolkata.
                </p>
                <form asp-controller="Admin" asp-action="SyncCityNews" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-info btn-sm w-100 text-dark">
                        Sync All Cities
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- 4. Hacker News API -->
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">⚡ Hacker News API</h5>
                    <span class="badge bg-secondary">REST API</span>
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    Official Firebase REST API for top trending global technology, systems engineering, AI, and startups.
                </p>
                <form asp-controller="Admin" asp-action="SyncHackerNews" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                        Sync Hacker News
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Add Custom Feed Source Form -->
<div class="card mb-4">
    <div class="card-header">
        Add Custom RSS / Atom Feed Source
    </div>
    <div class="card-body">
        <form asp-controller="Admin" asp-action="AddFeedSource" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()

            <div class="col-md-3">
                <label class="form-label" for="feedName">Source Name</label>
                <input type="text" id="feedName" name="name" required placeholder="e.g. The Hindu Delhi" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label" for="feedUrl">Feed XML / API URL</label>
                <input type="url" id="feedUrl" name="feedUrl" required placeholder="https://example.com/rss.xml" class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label" for="categorySlug">Category</label>
                <select id="categorySlug" name="categorySlug" class="form-select" required>
                    @foreach (var cat in Model.AvailableCategories)
                    {
                        <option value="@cat.Slug">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label" for="regionInput">Region / City</label>
                <input type="text" id="regionInput" name="region" placeholder="e.g. Delhi, Mumbai, India" class="form-control" value="Worldwide" />
            </div>

            <div class="col-md-2">
                <label class="form-label" for="locationScopeInput">Scope</label>
                <select id="locationScopeInput" name="locationScope" class="form-select">
                    <option value="Global">Worldwide (Global)</option>
                    <option value="National">National</option>
                    <option value="City/District">City / District</option>
                </select>
            </div>

            <div class="col-md-10">
                <label class="form-label" for="defaultImageUrl">Default Image URL (Optional)</label>
                <input type="url" id="defaultImageUrl" name="defaultImageUrl" placeholder="https://..." class="form-control" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    Add Feed
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Built-In Feeds Table -->
<div class="mb-4">
    <h4>Configured Feeds (Worldwide, India National &amp; City-wise)</h4>
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Source Name</th>
                <th>Region</th>
                <th>Scope</th>
                <th>Category</th>
                <th>Feed Endpoint</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var feed in Model.FeedSources)
            {
                <tr>
                    <td><strong>@feed.Name</strong></td>
                    <td><span class="badge bg-info text-dark">@feed.Region</span></td>
                    <td><span class="badge bg-light text-muted border">@feed.LocationScope</span></td>
                    <td><span class="badge bg-secondary">@feed.CategorySlug</span></td>
                    <td><code class="small text-break">@feed.FeedUrl</code></td>
                    <td class="text-end">
                        <form asp-controller="Admin" asp-action="SyncSpecificFeed" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="feedUrl" value="@feed.FeedUrl" />
                            <input type="hidden" name="categorySlug" value="@feed.CategorySlug" />
                            <input type="hidden" name="sourceName" value="@feed.Name" />
                            <input type="hidden" name="region" value="@feed.Region" />
                            <input type="hidden" name="locationScope" value="@feed.LocationScope" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                Fetch Now
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Recent Live Synced Articles -->
@if (Model.RecentLiveArticles.Any())
{
    <div>
        <h4>Recently Ingested Live Dispatches</h4>
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Region</th>
                    <th>Category</th>
                    <th>Wire Source</th>
                    <th>Published Time</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in Model.RecentLiveArticles)
                {
                    <tr>
                        <td>
                            <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" target="_blank" class="fw-bold">
                                @(article.Title.Length > 55 ? article.Title.Substring(0, 55) + "..." : article.Title)
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">@(string.IsNullOrEmpty(article.Region) ? "Worldwide" : article.Region)</span>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@article.Category?.Name</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@(article.SourceName ?? "Live Wire")</span>
                        </td>
                        <td class="small text-muted">
                            @(article.PublishedDate?.ToString("MMM dd, HH:mm") ?? "Recent")
                        </td>
                        <td class="text-end text-nowrap">
                            @if (!string.IsNullOrEmpty(article.SourceUrl))
                            {
                                <a href="@article.SourceUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm">
                                    Source
                                </a>
                            }
                            <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-outline-primary btn-sm">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
