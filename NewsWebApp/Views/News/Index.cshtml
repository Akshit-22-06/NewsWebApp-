@model NewsWebApp.ViewModels.NewsListViewModel

@{
    ViewData["Title"] = "News Articles";
}

<h1>News Articles</h1>

<div class="row mb-3">
    <div class="col-md-12">
        <form asp-controller="News" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search keywords..." />
            </div>
            <div class="col-auto">
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <select name="sourceType" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SourceType) ? "selected" : null)">All Sources</option>
                    <option value="live" selected="@(Model.SourceType == "live" ? "selected" : null)">Live Wire Only</option>
                    <option value="editorial" selected="@(Model.SourceType == "editorial" ? "selected" : null)">Editorial Only</option>
                </select>
            </div>
            <div class="col-auto">
                <select name="sortBy" class="form-select">
                    <option value="latest" selected="@(Model.SortBy == "latest" || string.IsNullOrEmpty(Model.SortBy) ? "selected" : null)">Latest</option>
                    <option value="popular" selected="@(Model.SortBy == "popular" ? "selected" : null)">Most Viewed</option>
                    <option value="liked" selected="@(Model.SortBy == "liked" ? "selected" : null)">Most Liked</option>
                    <option value="discussed" selected="@(Model.SortBy == "discussed" ? "selected" : null)">Most Discussed</option>
                    <option value="oldest" selected="@(Model.SortBy == "oldest" ? "selected" : null)">Oldest</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<p class="text-muted">Showing @Model.Articles.Count() of @Model.TotalArticles articles</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Author / Source</th>
            <th>Published Date</th>
            <th>Views</th>
            <th>Likes</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Articles) {
        <tr>
            <td>
                <a asp-action="Details" asp-route-slug="@item.Slug" class="fw-bold text-decoration-none">
                    @item.Title
                </a>
                @if (item.IsLiveSynced)
                {
                    <span class="badge bg-danger ms-1">Live</span>
                }
            </td>
            <td>
                <span class="badge bg-secondary">@item.Category?.Name</span>
            </td>
            <td>
                @(item.Author?.DisplayName ?? item.SourceName ?? "Staff")
            </td>
            <td>
                @(item.PublishedDate?.ToString("yyyy-MM-dd") ?? "Draft")
            </td>
            <td>
                @item.ViewCount
            </td>
            <td>
                @item.LikeCount
            </td>
            <td>
                <a asp-action="Details" asp-route-slug="@item.Slug" class="btn btn-sm btn-outline-primary">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-sourceType="@Model.SourceType"
                   asp-route-sortBy="@Model.SortBy">&laquo; Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@Model.SearchTerm"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-sourceType="@Model.SourceType"
                       asp-route-sortBy="@Model.SortBy">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-sourceType="@Model.SourceType"
                   asp-route-sortBy="@Model.SortBy">Next &raquo;</a>
            </li>
        </ul>
    </nav>
}
