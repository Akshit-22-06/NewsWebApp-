@model IEnumerable<NewsWebApp.Models.NewsArticle>
@{
    ViewData["Title"] = "AI Moderation Audit & History";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    string? selectedStatus = ViewBag.SelectedStatus as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1">AI Moderation Audit</h1>
        <p class="text-muted small mb-0">Complete evaluation records, quality scores, and safety flags generated by Google Gemini AI.</p>
    </div>
    <span class="badge bg-primary px-3 py-2">
        <i class="bi bi-cpu me-1"></i>Active Engine: gemini-3.5-flash-lite
    </span>
</div>

<partial name="_AdminNav" />

<!-- Filter Tabs -->
<div class="card card-editorial p-3 mb-4 bg-light">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="btn-group btn-group-sm">
            <a asp-action="AiModeration" asp-route-status="" class="btn @(string.IsNullOrEmpty(selectedStatus) ? "btn-dark" : "btn-outline-dark")">
                All Audited (@totalCount)
            </a>
            <a asp-action="AiModeration" asp-route-status="Approved" class="btn @(selectedStatus == "Approved" ? "btn-success" : "btn-outline-success")">
                Approved by AI
            </a>
            <a asp-action="AiModeration" asp-route-status="Rejected" class="btn @(selectedStatus == "Rejected" ? "btn-danger" : "btn-outline-danger")">
                Rejected / Flagged
            </a>
        </div>
        <div class="small text-muted">
            Minimum Passing Quality Score: <strong>50 / 100</strong>
        </div>
    </div>
</div>

<!-- Moderation Records Table -->
<div class="card card-editorial shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 260px;">Article Title &amp; Slug</th>
                    <th>Author</th>
                    <th>AI Score</th>
                    <th>Status</th>
                    <th>Detected Flags / Categories</th>
                    <th>AI Model</th>
                    <th>Moderated Time</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            No moderation audit records found.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="ReviewArticle" asp-route-id="@item.Id" class="fw-bold text-dark text-decoration-none">
                                @(item.Title.Length > 50 ? item.Title.Substring(0, 50) + "..." : item.Title)
                            </a>
                            <div class="text-muted small"><code>@item.Slug</code></div>
                            @if (!string.IsNullOrWhiteSpace(item.RejectionReason))
                            {
                                <div class="text-danger small mt-1">
                                    <i class="bi bi-chat-left-dots me-1"></i>@item.RejectionReason
                                </div>
                            }
                        </td>
                        <td>
                            @(item.Author?.DisplayName ?? "Staff")
                        </td>
                        <td>
                            @if (item.ModerationQualityScore.HasValue)
                            {
                                var score = item.ModerationQualityScore.Value;
                                <span class="badge @(score >= 80 ? "bg-success" : (score >= 50 ? "bg-primary" : "bg-danger"))" style="font-size: 0.85rem;">
                                    @score / 100
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Pending</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == NewsWebApp.Models.ArticleStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (item.Status == NewsWebApp.Models.ArticleStatus.Rejected)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ModerationCategories))
                            {
                                <span class="badge bg-light text-danger border border-danger-subtle small">
                                    @item.ModerationCategories
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">None (Clean)</span>
                            }
                        </td>
                        <td class="small text-muted">
                            @(item.ModerationModel ?? "gemini-3.5-flash-lite")
                        </td>
                        <td class="small text-muted">
                            @(item.ModeratedAt.HasValue ? item.ModeratedAt.Value.ToString("yyyy-MM-dd HH:mm") : item.CreatedAt.ToString("yyyy-MM-dd HH:mm"))
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="ReviewArticle" asp-route-id="@item.Id" class="btn btn-sm btn-editorial-outline">
                                Full Audit &rarr;
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="AiModeration" asp-route-page="@i" asp-route-status="@selectedStatus">@i</a>
                </li>
            }
        </ul>
    </nav>
}
