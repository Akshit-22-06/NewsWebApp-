@{
    ViewData["Title"] = "Access denied";
}

<header>
    <h1 class="text-danger">@ViewData["Title"]</h1>
    <p class="text-danger">You do not have permission to view or manage this administrative resource.</p>
</header>

<div>
    <p>Please log in with an authorized Author or Administrator account to proceed.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
    <a asp-controller="Account" asp-action="Login" class="btn btn-secondary">Sign In</a>
</div>
