{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "NewsSphere Role-to-Action Execution Flow",
    "output": "news-sphere-role-flow.html",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "anon-path",
        "label": "1. Anonymous Guest Flow",
        "focus": ["role_anon", "gate_anon", "ctrl_public", "exec_public", "repo_public"],
        "note": "Guests browse headlines, search articles, read stories, and register without authentication challenges."
      },
      {
        "id": "reader-path",
        "label": "2. Reader Engagement Flow",
        "focus": ["role_reader", "gate_reader", "ctrl_reader", "guard_reader", "repo_reader"],
        "note": "Readers submit discussion comments, manage personal reading bookmarks, and delete their own comments."
      },
      {
        "id": "author-path",
        "label": "3. Author Editorial Studio Flow",
        "focus": ["role_author", "gate_author", "ctrl_author", "guard_author", "repo_author"],
        "note": "Staff journalists author, edit, and toggle publication status of their own articles with ownership validation."
      },
      {
        "id": "admin-path",
        "label": "4. Administrator Operations Flow",
        "focus": ["role_admin", "gate_admin", "ctrl_admin", "guard_admin", "repo_admin"],
        "note": "Administrators command categories, moderate comments, audit accounts, and ingest multi-feed live news."
      }
    ]
  },
  "lanes": [
    { "id": "guest_lane", "label": "Anonymous (Guest) Pipeline" },
    { "id": "reader_lane", "label": "Reader Engagement Pipeline" },
    { "id": "author_lane", "label": "Author Editorial Studio" },
    { "id": "admin_lane", "label": "Administrator Command Hub" }
  ],
  "phases": [
    { "id": "phase_auth", "label": "Ingress & Identity Middleware", "fromCol": 0, "toCol": 1 },
    { "id": "phase_dispatch", "label": "Action Dispatch & Ownership Guard", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "phase_repo", "label": "Repository Pattern & Persistence", "fromCol": 4, "toCol": 4, "variant": "dashed" }
  ],
  "groups": [
    { "id": "grp_guest", "label": "Public Browsing Loop", "lane": "guest_lane", "fromCol": 1, "toCol": 3, "variant": "emphasis" },
    { "id": "grp_editorial", "label": "Editorial Studio", "lane": "author_lane", "fromCol": 1, "toCol": 3, "variant": "security" },
    { "id": "grp_admin", "label": "Platform Operations", "lane": "admin_lane", "fromCol": 1, "toCol": 3, "variant": "security" }
  ],
  "mainPath": [
    "role_reader",
    "gate_reader",
    "ctrl_reader",
    "guard_reader",
    "repo_reader"
  ],
  "nodes": [
    {
      "id": "role_anon",
      "lane": "guest_lane",
      "col": 0,
      "type": "external",
      "label": "Anonymous Guest",
      "sublabel": "Public Visitor",
      "tag": "Unauthenticated",
      "width": 140
    },
    {
      "id": "gate_anon",
      "lane": "guest_lane",
      "col": 1,
      "type": "frontend",
      "label": "AllowAnonymous",
      "sublabel": "No Auth Required",
      "tag": "Public Bypass",
      "width": 140
    },
    {
      "id": "ctrl_public",
      "lane": "guest_lane",
      "col": 2,
      "type": "backend",
      "label": "Public Actions",
      "sublabel": "Home, Category, News",
      "width": 140
    },
    {
      "id": "exec_public",
      "lane": "guest_lane",
      "col": 3,
      "type": "frontend",
      "label": "Public Exec",
      "sublabel": "Read Queries Only",
      "tag": "HTTP 200 OK",
      "width": 140
    },
    {
      "id": "repo_public",
      "lane": "guest_lane",
      "col": 4,
      "type": "backend",
      "label": "News Repos & Views",
      "sublabel": "INewsRepo / EF Core",
      "tag": "NoTracking",
      "width": 140
    },

