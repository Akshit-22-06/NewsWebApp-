@model IEnumerable<(NewsWebApp.Models.Category Category, int ArticleCount)>
@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<partial name="_AdminNav" />

<p>
    <a asp-action="CreateCategory" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Description</th>
            <th>Articles Count</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@item.Category.Name</strong>
                </td>
                <td>
                    <code>@item.Category.Slug</code>
                </td>
                <td class="text-muted small">
                    @(item.Category.Description ?? "No description.")
                </td>
                <td>
                    <span class="badge bg-secondary">@item.ArticleCount</span>
                </td>
                <td class="text-end text-nowrap">
                    <a asp-action="EditCategory" asp-route-id="@item.Category.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                    @if (item.ArticleCount == 0)
                    {
                        <form asp-action="DeleteCategory" asp-route-id="@item.Category.Id" method="post" class="d-inline" onsubmit="return confirm('Delete category @item.Category.Name?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted small">In Use</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
