    },
    {
      "id": "guard_author",
      "lane": "author_lane",
      "col": 3,
      "type": "security",
      "label": "Article Guard",
      "sublabel": "UserId == AuthorId",
      "tag": "403 Forbid",
      "width": 140
    },
    {
      "id": "repo_author",
      "lane": "author_lane",
      "col": 4,
      "type": "backend",
      "label": "Editorial Repos",
      "sublabel": "INewsRepo / EF Core",
      "tag": "Article CRUD",
