@model NewsWebApp.ViewModels.LiveNewsHubViewModel
@{
    ViewData["Title"] = "Live News Hub";
}

<h1>Live News Hub</h1>

<p class="text-muted">
    Multi-provider live news ingestion from Hacker News, GNews, NewsAPI.org, and Global RSS/Atom feeds.
</p>

<partial name="_AdminNav" />

<!-- Status Metrics Cards -->
<div class="row row-cols-1 row-cols-md-4 g-3 mb-4">
    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <h3 class="card-title text-primary">@Model.TotalLiveArticles</h3>
                <p class="card-text text-muted small">Live Ingested Stories</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <h3 class="card-title">@Model.TotalArticles</h3>
                <p class="card-text text-muted small">Total Platform Stories</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <h3 class="card-title @(Model.IsAutoSyncEnabled ? "text-success" : "text-warning")">
                    @(Model.IsAutoSyncEnabled ? "ACTIVE" : "PAUSED")
                </h3>
                <p class="card-text text-muted small">Background Poller</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <h3 class="card-title">@Model.SyncIntervalMinutes min</h3>
                <p class="card-text text-muted small">Auto-Poll Frequency</p>
            </div>
        </div>
    </div>
</div>

<!-- News API Providers -->
<h4>News API Providers &amp; Quick Actions</h4>
<div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
    <!-- 1. Hacker News API -->
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">Hacker News API</h5>
                    <span class="badge bg-success">Free / No Key</span>
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    Official Firebase REST API. Ingests top trending technology, systems engineering, AI, and startup headlines.
                </p>
                <form asp-controller="Admin" asp-action="SyncHackerNews" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                        Sync Hacker News
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. Global RSS Wire -->
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">Global Wire Feeds</h5>
                    <span class="badge bg-primary">@Model.FeedSources.Count Active</span>
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    Syndicated feeds from BBC World, TechCrunch, The Verge, NASA, ESPN, Politics, and Business beats.
                </p>
                <form asp-controller="Admin" asp-action="SyncLiveNews" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        Sync All Global Feeds
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- 3. GNews & NewsAPI -->
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">REST News APIs</h5>
                    @if (Model.HasGNewsApiKey || Model.HasNewsApiKey)
                    {
                        <span class="badge bg-success">Configured</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Key Optional</span>
                    }
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    GNews API &amp; NewsAPI.org. Provide your key in <code>appsettings.json</code> under <code>LiveNews</code>.
                </p>
                <form asp-controller="Admin" asp-action="SyncGNews" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm w-100" @(Model.HasGNewsApiKey ? "" : "disabled")>
                        Sync GNews API
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Add Custom Feed Source Form -->
<div class="card mb-4">
    <div class="card-header">
        Add Custom RSS / Atom Feed Source
    </div>
    <div class="card-body">
        <form asp-controller="Admin" asp-action="AddFeedSource" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()

            <div class="col-md-3">
                <label class="form-label" for="feedName">Source Name</label>
                <input type="text" id="feedName" name="name" required placeholder="e.g. Reuters Tech" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label" for="feedUrl">Feed XML URL</label>
                <input type="url" id="feedUrl" name="feedUrl" required placeholder="https://example.com/rss.xml" class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label" for="categorySlug">Category</label>
                <select id="categorySlug" name="categorySlug" class="form-select" required>
                    @foreach (var cat in Model.AvailableCategories)
                    {
                        <option value="@cat.Slug">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label" for="defaultImageUrl">Default Image URL</label>
                <input type="url" id="defaultImageUrl" name="defaultImageUrl" placeholder="https://..." class="form-control" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    Add Feed
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Custom Dynamic Feeds Table -->
@if (Model.CustomFeedSources != null && Model.CustomFeedSources.Any())
{
    <div class="mb-4">
        <h4>Custom Configured Feeds</h4>
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Source Name</th>
                    <th>Category</th>
                    <th>Feed URL</th>
                    <th>Last Synced</th>
                    <th>Imported</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var custom in Model.CustomFeedSources)
                {
                    <tr>
                        <td><strong>@custom.Name</strong></td>
                        <td><span class="badge bg-secondary">@custom.CategorySlug</span></td>
                        <td><code class="small text-break">@custom.FeedUrl</code></td>
                        <td class="small text-muted">@(custom.LastSyncedAt?.ToString("MMM dd, HH:mm") ?? "Never")</td>
                        <td>@custom.TotalArticlesImported</td>
                        <td>
                            @if (custom.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Paused</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <form asp-controller="Admin" asp-action="SyncCustomFeed" asp-route-id="@custom.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-primary btn-sm">Sync</button>
                            </form>

                            <form asp-controller="Admin" asp-action="ToggleFeedSource" asp-route-id="@custom.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    @(custom.IsActive ? "Pause" : "Resume")
                                </button>
                            </form>

                            <form asp-controller="Admin" asp-action="DeleteFeedSource" asp-route-id="@custom.Id" method="post" class="d-inline" onsubmit="return confirm('Remove feed @custom.Name?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Built-In Global Feeds Table -->
<div class="mb-4">
    <h4>Built-In Global Editorial Beats</h4>
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Source Name</th>
                <th>Target Category</th>
                <th>Feed Endpoint</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var feed in Model.FeedSources)
            {
                <tr>
                    <td><strong>@feed.Name</strong></td>
                    <td><span class="badge bg-secondary">@feed.CategorySlug</span></td>
                    <td><code class="small text-break">@feed.FeedUrl</code></td>
                    <td class="text-end">
                        <form asp-controller="Admin" asp-action="SyncSpecificFeed" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="feedUrl" value="@feed.FeedUrl" />
                            <input type="hidden" name="categorySlug" value="@feed.CategorySlug" />
                            <input type="hidden" name="sourceName" value="@feed.Name" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                Fetch Now
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Recent Live Synced Articles -->
@if (Model.RecentLiveArticles.Any())
{
    <div>
        <h4>Recently Ingested Live Dispatches</h4>
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Wire Source</th>
                    <th>Published Time</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in Model.RecentLiveArticles)
                {
                    <tr>
                        <td>
                            <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" target="_blank" class="fw-bold">
                                @(article.Title.Length > 55 ? article.Title.Substring(0, 55) + "..." : article.Title)
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@article.Category?.Name</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@(article.SourceName ?? "Live Wire")</span>
                        </td>
                        <td class="small text-muted">
                            @(article.PublishedDate?.ToString("MMM dd, HH:mm") ?? "Recent")
                        </td>
                        <td class="text-end text-nowrap">
                            @if (!string.IsNullOrEmpty(article.SourceUrl))
                            {
                                <a href="@article.SourceUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm">
                                    Source
                                </a>
                            }
                            <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-outline-primary btn-sm">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
