@model NewsWebApp.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Front Page - Daily Editorial & Global Wire";
    var leadArticle = Model.FeaturedArticles.FirstOrDefault() ?? Model.LatestArticles.FirstOrDefault();
    var localStories = Model.LatestArticles.Where(a => leadArticle == null || a.Id != leadArticle.Id).ToList();
}

<!-- Front Page Lead Story Section -->
@if (leadArticle != null)
{
    <section class="lead-story-section mb-4 pb-4 border-bottom">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-danger text-uppercase px-2 py-1 mb-2" style="font-size: 0.725rem; letter-spacing: 0.08em;">
                    @(leadArticle.IsFeatured ? "Featured Story" : "Lead Report") &bull; @(leadArticle.Category?.Name ?? "Special Coverage")
                </span>
                <h1 class="editorial-title display-6">
                    <a asp-controller="News" asp-action="Details" asp-route-slug="@leadArticle.Slug" class="text-dark text-decoration-none">
                        @leadArticle.Title
                    </a>
                </h1>
                <p class="editorial-standfirst mb-3">
                    @leadArticle.Summary
                </p>
                <div class="d-flex align-items-center flex-wrap gap-3 small text-muted">
                    <span>By <strong>@(leadArticle.Author?.DisplayName ?? leadArticle.SourceName ?? "Staff")</strong></span>
                    <span>&bull;</span>
                    <span>@(leadArticle.PublishedDate?.ToString("MMMM dd, yyyy") ?? "Recent")</span>
                    <span>&bull;</span>
                    <span><i class="bi bi-eye me-1"></i>@leadArticle.ViewCount views</span>
                    
                    <div class="ms-auto d-flex gap-2">
                        <a asp-controller="News" asp-action="Details" asp-route-slug="@leadArticle.Slug" class="btn btn-sm btn-editorial-primary">
                            Read Full Report &rarr;
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="News" asp-action="ToggleBookmark" asp-route-id="@leadArticle.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="/" />
                                <button type="submit" class="btn btn-sm btn-editorial-outline" title="Bookmark story">
                                    <i class="bi bi-bookmark"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                @if (!string.IsNullOrWhiteSpace(leadArticle.ImageUrl))
                {
                    <img src="@leadArticle.ImageUrl" alt="@leadArticle.Title" class="img-fluid rounded-1 border w-100 shadow-sm" style="height: 320px; object-fit: cover;" onerror="this.style.display='none';" />
                }
                else
                {
                    <div class="bg-light border rounded-1 p-4 d-flex align-items-center justify-content-center text-center text-muted" style="height: 320px;">
                        <div>
                            <i class="bi bi-newspaper display-3 d-block text-secondary mb-2"></i>
                            <span class="small text-uppercase fw-semibold">NewsBase Special Dispatch</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<div class="row g-4">
    <!-- Main Editorial Feed Column -->
    <div class="col-lg-8">

        <!-- NewsBase Dispatches Grid -->
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h2 class="editorial-headline h4 mb-0">Editorial Dispatches</h2>
            <a asp-controller="News" asp-action="Index" class="btn btn-sm btn-editorial-outline">All Stories &rarr;</a>
        </div>

        @if (localStories.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
                @foreach (var article in localStories.Take(6))
                {
                    <div class="col">
                        <div class="card h-100 card-editorial p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary small">@(article.Category?.Name ?? "General")</span>
                                <small class="text-muted">@(article.PublishedDate?.ToString("MMM dd") ?? "Recent")</small>
                            </div>
                            <h3 class="h5 font-serif mb-2">
                                <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="text-dark text-decoration-none">
                                    @article.Title
                                </a>
                            </h3>
                            <p class="text-muted small flex-grow-1">
                                @(article.Summary.Length > 110 ? article.Summary.Substring(0, 110) + "..." : article.Summary)
                            </p>
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center small text-muted">
                                <span>By @(article.Author?.DisplayName ?? "Staff")</span>
                                <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-sm btn-editorial-outline">
                                    Read &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light border py-3 px-3 mb-5 text-muted small">
                No secondary dispatches yet. Check back soon for fresh reporting.
            </div>
        }

        <!-- Global Live Wire (Currents API) -->
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <div>
                <h2 class="editorial-headline h4 mb-0">Live International Wire</h2>
                <small class="text-muted">Real-time syndicated dispatches</small>
            </div>
            <a asp-controller="News" asp-action="Index" asp-route-source="wire" class="btn btn-sm btn-editorial-outline">Wire Desk &rarr;</a>
        </div>

        @if (Model.LiveNews != null && Model.LiveNews.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                @foreach (var news in Model.LiveNews.Take(6))
                {
                    <div class="col">
                        <div class="card h-100 card-editorial p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-light text-dark border small">@(string.IsNullOrWhiteSpace(news.Category) ? "World" : news.Category)</span>
                                <small class="text-muted">@(news.Published.HasValue ? news.Published.Value.ToString("MMM dd HH:mm") : "Recent")</small>
                            </div>
                            <h3 class="h6 font-serif mb-2">
                                @if (!string.IsNullOrWhiteSpace(news.Url))
                                {
                                    <a href="@news.Url" target="_blank" rel="noopener noreferrer" class="text-dark text-decoration-none">
                                        @news.Title
                                    </a>
                                }
                                else
                                {
                                    <span>@news.Title</span>
                                }
                            </h3>
                            <p class="text-muted small flex-grow-1">
                                @(string.IsNullOrWhiteSpace(news.Description) ? "" : (news.Description.Length > 95 ? news.Description.Substring(0, 95) + "..." : news.Description))
                            </p>
                            @if (!string.IsNullOrWhiteSpace(news.Url))
                            {
                                <div class="mt-auto pt-2 border-top text-end">
                                    <a href="@news.Url" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-editorial-outline">
                                        Wire Dispatch &nearr;
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light border py-3 px-3 mb-4 text-muted small">
                Live international wire is updating. Please refresh in a moment.
            </div>
        }

    </div>

    <!-- Right Sidebar Column -->
    <div class="col-lg-4">

        <!-- Trending News Today Ranking -->
        <div class="card card-editorial p-3 mb-4">
            <div class="mb-1">
                <span class="text-uppercase fw-bold text-muted" style="font-size: 0.68rem; letter-spacing: 1.5px;">Trending</span>
            </div>
            <h3 class="editorial-headline h5 mb-3 pb-2 border-bottom text-dark">
                Trending News Today
            </h3>
            @if (Model.TrendingArticles != null && Model.TrendingArticles.Any())
            {
                <ol class="list-unstyled mb-0">
                    @{ int rank = 1; }
                    @foreach (var item in Model.TrendingArticles)
                    {
                        <li class="d-flex align-items-start mb-3 pb-3 border-bottom">
                            <span class="font-serif fw-bold text-muted me-3" style="font-size: 1.5rem; line-height: 1;">@(rank++)</span>
                            <div class="flex-grow-1">
                                @if (!string.IsNullOrWhiteSpace(item.Url) && (item.Url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || item.Url.StartsWith("https://", StringComparison.OrdinalIgnoreCase)))
                                {
                                    <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="text-dark text-decoration-none font-serif fw-bold d-block mb-1" style="font-size: 0.95rem; line-height: 1.35;">
                                        @item.Title
                                    </a>
                                }
                                else
                                {
                                    <span class="text-dark font-serif fw-bold d-block mb-1" style="font-size: 0.95rem; line-height: 1.35;">
                                        @item.Title
                                    </span>
                                }
                                <div class="text-muted small" style="font-size: 0.78rem;">
                                    <span>@item.CategoryName</span>
                                    @if (!string.IsNullOrWhiteSpace(item.SourceName))
                                    {
                                        <span class="mx-1">&bull;</span>
                                        <span>@item.SourceName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.FormattedTimeAgo))
                                    {
                                        <span class="mx-1">&bull;</span>
                                        <span>@item.FormattedTimeAgo</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="text-muted small mb-0">No trending news available right now. Please check again shortly.</p>
            }
        </div>

        <!-- Sections / Categories Navigation -->
        <div class="card card-editorial p-3 mb-4">
            <h3 class="editorial-headline h5 mb-3 pb-2 border-bottom">
                Browse Sections
            </h3>
            <div class="list-group list-group-flush">
                @if (Model.CategoriesWithCounts != null && Model.CategoriesWithCounts.Any())
                {
                    @foreach (var cat in Model.CategoriesWithCounts)
                    {
                        <a asp-controller="News" asp-action="Category" asp-route-slug="@cat.Category.Slug" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-2">
                            <span>@cat.Category.Name</span>
                            <span class="badge bg-light text-muted border rounded-pill">@cat.ArticleCount</span>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- The Morning Dispatch Newsletter Section -->
        <div class="card card-editorial newsletter-dispatch-box p-4 mb-4">
            <h3 class="editorial-headline h4 mb-2 text-dark">The Morning Dispatch</h3>
            <p class="text-muted small mb-3" style="line-height: 1.55;">
                Essential reporting, investigative features, and global headlines delivered to your inbox.
            </p>
            <form id="morningDispatchForm" asp-controller="Newsletter" asp-action="Subscribe" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="/" />
                <div class="mb-2">
                    <input type="email" name="email" id="morningDispatchEmail" class="form-control form-control-sm border-secondary-subtle" placeholder="Your email address" required autocomplete="email" />
                </div>
                <button id="morningDispatchBtn" class="btn btn-editorial-primary btn-sm w-100" type="submit">
                    Join Newsletter
                </button>
            </form>
            <div id="morningDispatchFeedback" style="display: none;"></div>
            <div class="text-muted small mt-2" style="font-size: 0.78rem;">
                Unsubscribe at any time &bull; Privacy protected
            </div>
        </div>

        <!-- Author Spotlight Card -->
        <div class="card card-editorial p-3">
            <h4 class="editorial-headline h6 mb-2">Contribute to NewsBase</h4>
            <p class="small text-muted mb-3">Are you a journalist or independent researcher? Publish stories through our automated AI editorial desk.</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-editorial-outline w-100">
                Become a Contributor &rarr;
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('morningDispatchForm');
            if (!form) return;

            const input = document.getElementById('morningDispatchEmail');
            const btn = document.getElementById('morningDispatchBtn');
            const feedback = document.getElementById('morningDispatchFeedback');

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const email = (input.value || '').trim();
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                if (!email || !emailRegex.test(email)) {
                    feedback.className = 'alert alert-warning py-2 px-3 small mt-3 mb-0';
                    feedback.textContent = 'Please enter a valid email address.';
                    feedback.style.display = 'block';
                    input.focus();
                    return;
                }

                // Construct FormData and set email BEFORE disabling elements (per HTML spec, disabled inputs are excluded from FormData)
                const formData = new FormData(form);
                formData.set('email', email);

                // Prevent multiple submissions & display loading state
                btn.disabled = true;
                input.readOnly = true;
                const originalText = btn.innerHTML;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Subscribing...';
                feedback.style.display = 'none';

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        }
                    });

                    const data = await response.json();
                    if (data.success) {
                        feedback.className = 'alert alert-success py-2 px-3 small mt-3 mb-0';
                        feedback.textContent = data.message || 'Thank you for subscribing! You are now part of The Morning Dispatch.';
                        feedback.style.display = 'block';
                        input.value = '';
                    } else {
                        feedback.className = 'alert alert-danger py-2 px-3 small mt-3 mb-0';
                        feedback.textContent = data.message || 'This email address is already subscribed to our newsletter.';
                        feedback.style.display = 'block';
                    }
                } catch (err) {
                    feedback.className = 'alert alert-danger py-2 px-3 small mt-3 mb-0';
                    feedback.textContent = 'A network error occurred. Please try again.';
                    feedback.style.display = 'block';
                } finally {
                    btn.disabled = false;
                    input.readOnly = false;
                    btn.innerHTML = originalText;
                }
            });
        });
    </script>
}
