@model IEnumerable<NewsWebApp.Models.NewsArticle>
@{
    ViewData["Title"] = "Manage Articles";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    string? search = ViewBag.Search as string;
    int? categoryId = ViewBag.CategoryId as int?;
    bool? isPublished = ViewBag.IsPublished as bool?;
    var categories = ViewBag.Categories as IEnumerable<NewsWebApp.Models.Category> ?? Enumerable.Empty<NewsWebApp.Models.Category>();
}

<h1>Articles</h1>

<partial name="_AdminNav" />

<p>
    <a asp-action="CreateArticle" class="btn btn-primary">Create New</a>
</p>

<!-- Filter Toolbar -->
<form asp-controller="Admin" asp-action="Articles" method="get" class="row g-3 mb-4 align-items-end">
    <div class="col-md-4">
        <label class="form-label" for="search">Title Search</label>
        <input type="text" id="search" name="search" value="@search" placeholder="Search keywords..." class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label" for="categoryId">Category</label>
        <select id="categoryId" name="categoryId" class="form-select">
            <option value="">All Categories</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(categoryId == c.Id ? "selected" : null)">
                    @c.Name
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label" for="isPublished">Status</label>
        <select id="isPublished" name="isPublished" class="form-select">
            <option value="">All Statuses</option>
            <option value="true" selected="@(isPublished == true ? "selected" : null)">Published</option>
            <option value="false" selected="@(isPublished == false ? "selected" : null)">Draft</option>
        </select>
    </div>

    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
        <a asp-controller="Admin" asp-action="Articles" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Author</th>
            <th>Views</th>
            <th>Status</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Featured</th>
            }
            <th>Created</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted py-4">
                    No articles found matching the filter criteria.
                </td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a asp-controller="News" asp-action="Details" asp-route-slug="@item.Slug" target="_blank" class="fw-bold">
                        @(item.Title.Length > 55 ? item.Title.Substring(0, 55) + "..." : item.Title)
                    </a>
                    <div class="text-muted small">
                        Slug: <code>@item.Slug</code>
                    </div>
                </td>
                <td>
                    <span class="badge bg-secondary">@item.Category?.Name</span>
                </td>
                <td>
                    @(item.Author?.DisplayName ?? "Staff")
                </td>
                <td>
                    @item.ViewCount
                </td>
                <td>
                    <form asp-controller="Admin" asp-action="TogglePublish" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        @if (item.IsPublished)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Click to unpublish">
                                Published
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Click to publish">
                                Draft
                            </button>
                        }
                    </form>
                </td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <form asp-controller="Admin" asp-action="ToggleFeatured" asp-route-id="@item.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (item.IsFeatured)
                            {
                                <button type="submit" class="btn btn-sm btn-primary" title="Click to remove featured">
                                    Yes
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Click to make featured">
                                    No
                                </button>
                            }
                        </form>
                    </td>
                }
                <td class="small text-muted">
                    @item.CreatedAt.ToString("yyyy-MM-dd")
                </td>
                <td class="text-end text-nowrap">
                    <a asp-action="EditArticle" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                    <a asp-controller="News" asp-action="Details" asp-route-slug="@item.Slug" class="btn btn-outline-info btn-sm">Details</a>
                    <a asp-action="DeleteArticle" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage > 1 ? "" : "disabled")">
                <a class="page-link"
                   asp-controller="Admin"
                   asp-action="Articles"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-search="@search"
                   asp-route-categoryId="@categoryId"
                   asp-route-isPublished="@isPublished">
                    Previous
                </a>
            </li>

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link"
                       asp-controller="Admin"
                       asp-action="Articles"
                       asp-route-page="@p"
                       asp-route-search="@search"
                       asp-route-categoryId="@categoryId"
                       asp-route-isPublished="@isPublished">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(currentPage < totalPages ? "" : "disabled")">
                <a class="page-link"
                   asp-controller="Admin"
                   asp-action="Articles"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-search="@search"
                   asp-route-categoryId="@categoryId"
                   asp-route-isPublished="@isPublished">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}
