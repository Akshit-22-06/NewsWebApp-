  "cards": [
    {
      "dot": "cyan",
      "title": "Public & Anonymous Pipeline",
      "items": [
        "Unauthenticated visitors access HomeController, CategoryController, AuthorController, and NewsController public actions",
        "Endpoints execute with AsNoTracking() read optimizations for high throughput and zero cookie challenge overhead",
        "Self-registration via AccountController assigns the default 'Reader' role and establishes encrypted cookie sessions"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reader & Author Interaction Rails",
      "items": [
        "Authenticated Readers gain access to bookmarks (/news/bookmarks) and interactive commenting (/news/addcomment)",
        "Staff Authors access the editorial studio (/admin) to author, edit, and toggle publish state on their own articles",
        "Granular resource ownership guards enforce article.Author.UserId == currentUserId; foreign access triggers HTTP 403 Forbid()"
      ]
    },
    {
      "dot": "violet",
      "title": "Administrator Operations & Multi-Feed Sync",
      "items": [
        "Administrators hold superuser privileges across all controllers, overriding author article boundaries",
        "Exclusive Admin actions include Category CRUD, global comment deletion, user role auditing, and newsletter subscriber tracking",
        "The Live News Hub (/admin/livenews) coordinates on-demand and background ingestion across Hacker News, GNews, and RSS XML feeds"
      ]
    }
  ]
}
