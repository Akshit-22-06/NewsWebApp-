  "cards": [
    {
      "dot": "cyan",
      "title": "Editorial Domain",
      "items": [
        "NewsArticle has foreign keys to Category (CategoryId) and Author (AuthorId)",
        "Slugs are uniquely indexed on NewsArticle and Category for clean SEO URLs",
        "Author profile optionally links 1:0..1 to an ApplicationUser account"
      ]
    },
    {
      "dot": "emerald",
      "title": "Engagement & Social",
      "items": [
        "Comments are tied to both NewsArticle and ApplicationUser with moderation flags",
        "ArticleBookmark enables readers to create personalized reading lists",
        "Cascade delete behaviors are managed to prevent cyclical database locks"
      ]
    },
    {
      "dot": "violet",
      "title": "Ingestion & Growth",
      "items": [
        "NewsFeedSource stores external RSS/API endpoints and maps to Category slugs",
        "NewsletterSubscriber tracks opted-in subscriber emails and active states",
        "Managed via ApplicationDbContext with asynchronous LINQ and AsNoTracking queries"
      ]
    }
  ]
