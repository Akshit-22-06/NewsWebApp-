@model NewsWebApp.Models.Author
@{
    ViewData["Title"] = $"{Model.DisplayName} - NewsBase Journalist";
}

<div class="container" style="max-width: 960px;">
    <!-- Author Profile Header -->
    <div class="card card-editorial p-4 mb-5 bg-light">
        <div class="row align-items-center g-4">
            <div class="col-md-auto text-center">
                <img src="@(string.IsNullOrEmpty(Model.ProfileImageUrl) ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&auto=format&fit=crop&q=80" : Model.ProfileImageUrl)"
                     alt="@Model.DisplayName"
                     class="rounded-circle border shadow-sm" style="width: 110px; height: 110px; object-fit: cover;" />
            </div>
            <div class="col-md">
                <span class="badge bg-secondary mb-2">Staff Correspondent</span>
                <h1 class="editorial-headline h2 mb-2">@Model.DisplayName</h1>
                <p class="text-muted mb-3" style="font-size: 1.05rem;">
                    @(Model.Bio ?? "Investigative reporter and analytical contributor covering developments across politics, enterprise technology, and public affairs for NewsBase.")
                </p>
                <div class="d-flex flex-wrap gap-3 small text-muted">
                    <span><i class="bi bi-newspaper me-1"></i><strong>@Model.NewsArticles.Count</strong> Published Dispatches</span>
                    @if (Model.User != null)
                    {
                        <span><i class="bi bi-envelope me-1"></i>@Model.User.Email</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Published Articles Portfolio -->
    <div class="mb-4">
        <h3 class="editorial-headline h4 mb-3 pb-2 border-bottom">
            Published Articles by @Model.DisplayName
        </h3>

        @if (!Model.NewsArticles.Any())
        {
            <div class="alert alert-light border py-4 text-center text-muted">
                <p class="mb-0">No published articles available by this author yet.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var article in Model.NewsArticles.OrderByDescending(a => a.PublishedDate ?? a.CreatedAt))
                {
                    <div class="col-md-6">
                        <div class="card h-100 card-editorial p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary small">@(article.Category?.Name ?? "General")</span>
                                <span class="text-muted small"><i class="bi bi-eye me-1"></i>@article.ViewCount</span>
                            </div>
                            <h4 class="h5 font-serif mb-2">
                                <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="text-dark text-decoration-none">
                                    @article.Title
                                </a>
                            </h4>
                            <p class="text-muted small flex-grow-1">
                                @(article.Summary.Length > 110 ? article.Summary.Substring(0, 110) + "..." : article.Summary)
                            </p>
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center small text-muted">
                                <span>@(article.PublishedDate?.ToString("MMM dd, yyyy") ?? "Recent")</span>
                                <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-sm btn-editorial-outline">
                                    Read Article &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="mt-4 pt-3 border-top text-center">
        <a asp-action="Index" class="btn btn-editorial-outline btn-sm">
            &larr; View All Correspondents
        </a>
    </div>
</div>
