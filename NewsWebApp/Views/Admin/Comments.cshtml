@model IEnumerable<NewsWebApp.Models.Comment>
@{
    ViewData["Title"] = "Moderate Comments";
}

<h1>Moderate Comments</h1>

<partial name="_AdminNav" />

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>User</th>
            <th>Article</th>
            <th>Comment</th>
            <th>Date</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    No comments found.
                </td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@(item.User?.FullName ?? "Reader")</strong>
                    <div class="text-muted small">@item.User?.Email</div>
                </td>
                <td>
                    <a asp-controller="News" asp-action="Details" asp-route-slug="@item.NewsArticle?.Slug" target="_blank">
                        @(item.NewsArticle?.Title.Length > 40 ? item.NewsArticle?.Title.Substring(0, 40) + "..." : item.NewsArticle?.Title)
                    </a>
                </td>
                <td style="max-width: 350px;">
                    @item.Content
                </td>
                <td class="text-muted small text-nowrap">
                    @item.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </td>
                <td class="text-end">
                    <form asp-action="DeleteComment" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Permanently remove this comment?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
