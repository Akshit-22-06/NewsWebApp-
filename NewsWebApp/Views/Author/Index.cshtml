@model IEnumerable<NewsWebApp.Models.Author>
@{
    ViewData["Title"] = "Our Journalists & Correspondents";
}

<div class="mb-4 pb-2 border-bottom">
    <h1 class="editorial-headline h2 mb-1">Our Journalists &amp; Contributors</h1>
    <p class="text-muted small mb-0">Meet the independent reporters, columnists, and investigative journalists behind NewsBase.</p>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    @foreach (var author in Model)
    {
        <div class="col">
            <div class="card h-100 card-editorial p-4 text-center">
                <img src="@(string.IsNullOrEmpty(author.ProfileImageUrl) ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop&q=80" : author.ProfileImageUrl)"
                     alt="@author.DisplayName"
                     class="rounded-circle mx-auto mb-3 border shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
                
                <h3 class="h5 font-serif mb-1">@author.DisplayName</h3>
                <span class="badge bg-secondary-subtle text-secondary-emphasis small mb-3 align-self-center">Correspondent</span>
                
                <p class="text-muted small flex-grow-1">
                    @(author.Bio ?? "Contributor reporting on public affairs, technology, and global developments.")
                </p>

                <div class="pt-3 border-top d-flex justify-content-between align-items-center small text-muted">
                    <span><strong>@author.NewsArticles.Count</strong> Stories</span>
                    <a asp-action="Details" asp-route-id="@author.Id" class="btn btn-sm btn-editorial-outline">
                        View Profile &rarr;
                    </a>
                </div>
            </div>
        </div>
    }
</div>
