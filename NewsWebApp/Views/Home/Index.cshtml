@model NewsWebApp.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="p-4 p-md-5 mb-4 rounded bg-light border text-center">
    <h1 class="display-5 fw-bold">NewsBase</h1>
    <p class="lead text-muted mb-0">Latest news from around the world and local stories.</p>
</div>

<div class="row">
    <!-- Main Content Area -->
    <div class="col-lg-8">

        <!-- 1. Latest Live News (Currents API) -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h3 mb-0">Latest News</h2>
            <a asp-controller="News" asp-action="Index" class="btn btn-sm btn-outline-primary">View All &rarr;</a>
        </div>
        <p class="text-muted small mb-3">Live headlines powered by Currents API</p>

        @if (Model.LiveNews != null && Model.LiveNews.Any())
        {
            <div class="row g-3 mb-5">
                @foreach (var news in Model.LiveNews.Take(6))
                {
                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border">
                            @if (!string.IsNullOrWhiteSpace(news.Image))
                            {
                                <img src="@news.Image" class="card-img-top" alt="@news.Title" style="height: 180px; object-fit: cover;" onerror="this.style.display='none';" />
                            }
                            <div class="card-body d-flex flex-column">
                                @if (!string.IsNullOrWhiteSpace(news.Category))
                                {
                                    <span class="badge bg-secondary mb-2 align-self-start">@news.Category</span>
                                }
                                <h5 class="card-title h6">
                                    @if (!string.IsNullOrWhiteSpace(news.Url))
                                    {
                                        <a href="@news.Url" target="_blank" rel="noopener noreferrer" class="text-dark text-decoration-none">
                                            @news.Title
                                        </a>
                                    }
                                    else
                                    {
                                        @news.Title
                                    }
                                </h5>
                                @if (!string.IsNullOrWhiteSpace(news.Description))
                                {
                                    <p class="card-text text-muted small flex-grow-1">
                                        @(news.Description.Length > 110 ? news.Description.Substring(0, 110) + "..." : news.Description)
                                    </p>
                                }
                                <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center small text-muted">
                                    <span>@(news.Published.HasValue ? news.Published.Value.ToString("MMM dd, yyyy") : "Recent")</span>
                                    @if (!string.IsNullOrWhiteSpace(news.Url))
                                    {
                                        <a href="@news.Url" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">Read Article</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info mb-5" role="alert">
                No latest news is available right now.
            </div>
        }

        <!-- 2. NewsBase Local Articles -->
        <h2 class="h3 mb-3">NewsBase Articles</h2>
        <hr class="mb-4" />

        @if (Model.FeaturedArticles.Any())
        {
            var featured = Model.FeaturedArticles.First();
            <div class="card mb-4 border shadow-sm">
                <div class="card-body">
                    <span class="badge bg-primary mb-2">Featured: @featured.Category?.Name</span>
                    <h3 class="card-title h4">
                        <a asp-controller="News" asp-action="Details" asp-route-slug="@featured.Slug" class="text-decoration-none text-dark">
                            @featured.Title
                        </a>
                    </h3>
                    <p class="card-text text-muted">@featured.Summary</p>
                    <div class="text-muted small mb-3">
                        By @(featured.Author?.DisplayName ?? featured.SourceName ?? "Staff") | 
                        @(featured.PublishedDate?.ToString("MMMM dd, yyyy") ?? "Recent") | 
                        @featured.ViewCount views
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="News" asp-action="Details" asp-route-slug="@featured.Slug" class="btn btn-sm btn-primary">Read More &rarr;</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="News" asp-action="ToggleBookmark" asp-route-id="@featured.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="/" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Bookmark</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/" class="btn btn-sm btn-outline-secondary">Bookmark</a>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.LatestArticles != null && Model.LatestArticles.Any())
        {
            @foreach (var article in Model.LatestArticles)
            {
                <div class="mb-4 pb-3 border-bottom">
                    <span class="badge bg-secondary mb-1">@article.Category?.Name</span>
                    <h4 class="h5">
                        <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="text-decoration-none text-dark">
                            @article.Title
                        </a>
                    </h4>
                    <p class="text-muted small mb-2">@article.Summary</p>
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="text-muted small">
                            Published: @(article.PublishedDate?.ToString("MMM dd, yyyy") ?? "Recent") | By: @(article.Author?.DisplayName ?? article.SourceName ?? "Staff") | @article.ViewCount views
                        </div>
                        <div class="d-flex gap-1">
                            <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-sm btn-outline-primary">Read</a>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="News" asp-action="ToggleBookmark" asp-route-id="@article.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="/" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Bookmark</button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/" class="btn btn-sm btn-outline-secondary">Bookmark</a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No local articles available yet.</p>
        }

    </div>

    <!-- Sidebar Area -->
    <div class="col-lg-4">

        <!-- Trending (Popular Local Articles) -->
        <h3 class="h4 mb-3">Trending</h3>
        <hr class="mb-3" />
        <ul class="list-group mb-4 shadow-sm">
            @if (Model.PopularArticles != null && Model.PopularArticles.Any())
            {
                @foreach (var pop in Model.PopularArticles)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a asp-controller="News" asp-action="Details" asp-route-slug="@pop.Slug" class="text-decoration-none text-dark small">
                            @pop.Title
                        </a>
                        <span class="badge bg-primary rounded-pill">@pop.ViewCount</span>
                    </li>
                }
            }
            else
            {
                <li class="list-group-item text-muted small">No trending stories yet.</li>
            }
        </ul>

        <!-- Categories -->
        <h3 class="h4 mb-3">Categories</h3>
        <hr class="mb-3" />
        <div class="list-group mb-4 shadow-sm">
            @if (Model.CategoriesWithCounts != null && Model.CategoriesWithCounts.Any())
            {
                @foreach (var cat in Model.CategoriesWithCounts)
                {
                    <a asp-controller="News" asp-action="Category" asp-route-slug="@cat.Category.Slug" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>@cat.Category.Name</span>
                        <span class="badge bg-secondary rounded-pill">@cat.ArticleCount</span>
                    </a>
                }
            }
            else
            {
                <div class="list-group-item text-muted small">No categories found.</div>
            }
        </div>

        <!-- Newsletter Subscription -->
        <div class="card bg-light border shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title h6 fw-bold">Newsletter</h5>
                <p class="card-text small text-muted">Subscribe to receive our latest news briefing directly to your inbox.</p>
                <form asp-controller="Home" asp-action="Subscribe" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="/" />
                    <div class="input-group mb-2">
                        <input type="email" name="email" class="form-control" placeholder="Your email address" required />
                        <button class="btn btn-outline-primary" type="submit">Subscribe</button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
