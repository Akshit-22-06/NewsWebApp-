    },

    {
      "id": "role_admin",
      "lane": "admin_lane",
      "col": 0,
      "type": "external",
      "label": "Administrator",
      "sublabel": "Chief Editor & Ops",
      "tag": "Admin Claim",
      "width": 140
    },
    {
      "id": "gate_admin",
      "lane": "admin_lane",
