@model NewsWebApp.ViewModels.CreateAuthorArticleViewModel
@{
    ViewData["Title"] = "Submit New Article for Review";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h1 class="h2 mb-1">Submit Article</h1>
                <p class="text-muted mb-0">Write and submit your article for administrator review and approval.</p>
            </div>
            <div>
                <a asp-controller="Author" asp-action="Dashboard" class="btn btn-outline-secondary">
                    Back to Studio
                </a>
            </div>
        </div>

        <div class="alert alert-primary py-2 px-3 mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-cpu-fill text-primary fs-4 me-3"></i>
            <div>
                <strong>Gemini AI Editorial Review:</strong> Your submission will be evaluated automatically by our Google Gemini editorial AI. Articles that pass safety and quality standards will be <strong>approved and published immediately</strong>.
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form id="articleCreateForm" asp-controller="Author" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Article Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Enter a descriptive headline..." />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="">-- Choose Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label fw-semibold">Featured Image URL (Optional)</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        <div class="form-text">Direct link to an image for this article.</div>
                    </div>

                    <!-- Summary -->
                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fw-semibold">Summary / Subheading <span class="text-danger">*</span></label>
                        <textarea asp-for="Summary" class="form-control" rows="3" placeholder="Brief summary of the article (max 500 characters)..."></textarea>
                        <span asp-validation-for="Summary" class="text-danger small"></span>
                    </div>

                    <!-- Content -->
                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold">Article Body <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" class="form-control" rows="12" placeholder="Write your full article content here..."></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>

                    <!-- Loading Status Indicator -->
                    <div id="aiReviewLoadingBanner" class="alert alert-info py-2 px-3 mb-3 d-none align-items-center">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        <div><strong>Analyzing article with Gemini AI...</strong> Evaluating article quality, structure, and editorial safety guidelines. Please wait.</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-controller="Author" asp-action="Dashboard" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" id="btnSubmitArticle" class="btn btn-primary px-4">
                            <span id="btnSubmitSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true"></span>
                            <span id="btnSubmitText">Submit for Review</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('articleCreateForm');
            const submitBtn = document.getElementById('btnSubmitArticle');
            const submitSpinner = document.getElementById('btnSubmitSpinner');
            const submitText = document.getElementById('btnSubmitText');
            const loadingBanner = document.getElementById('aiReviewLoadingBanner');

            if (form && submitBtn) {
                form.addEventListener('submit', function (e) {
                    if (window.jQuery && !$(form).valid()) {
                        return; // Form is invalid, let unobtrusive validation show errors
                    }

                    // Show loading state and prevent duplicate clicks
                    submitBtn.disabled = true;
                    submitSpinner.classList.remove('d-none');
                    submitText.textContent = 'Reviewing with Gemini AI...';
                    if (loadingBanner) {
                        loadingBanner.classList.remove('d-none');
                        loadingBanner.classList.add('d-flex');
                    }
                });
            }
        });
    </script>
}
