@model NewsWebApp.ViewModels.LiveNewsHubViewModel
@{
    ViewData["Title"] = "Currents News";
    var selectedCategory = Model.SelectedCategory;
    var searchQuery = Model.SearchQuery;
}

<h1>Currents News</h1>

<p class="text-muted">
    Live external news feed powered by the Currents API. Check API status, fetch latest dispatches, and review incoming headlines.
</p>

<partial name="_AdminNav" />

<!-- Currents API Status Card -->
<div class="card mb-4 border-0 shadow-sm bg-light">
    <div class="card-body">
        <h5 class="card-title mb-3">Currents API Configuration Status</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <strong>Base URL:</strong>
                <code>@Model.BaseUrl</code>
            </div>
            <div class="col-md-6">
                <strong>API Key Status:</strong>
                @if (Model.IsApiKeyConfigured)
                {
                    <span class="badge bg-success">Configured &amp; Active</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Missing / Not Set</span>
                    <div class="text-muted small mt-1">
                        Configure your key in <code>appsettings.json</code> under <code>CurrentsApi:ApiKey</code>.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Fetch & Filter Controls -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <form asp-controller="Admin" asp-action="LiveNews" method="get" class="row g-2 align-items-center">
            <div class="col-md-5 col-sm-12">
                <input type="text" name="search" value="@searchQuery" class="form-control" placeholder="Search keywords (e.g. artificial intelligence)..." />
            </div>
            <div class="col-md-4 col-sm-6">
                <select name="category" class="form-select">
                    <option value="">All Categories</option>
                    <!option value="technology" @(string.Equals(selectedCategory, "technology", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Technology</!option>
                    <!option value="business" @(string.Equals(selectedCategory, "business", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Business</!option>
                    <!option value="sports" @(string.Equals(selectedCategory, "sports", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Sports</!option>
                    <!option value="entertainment" @(string.Equals(selectedCategory, "entertainment", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Entertainment</!option>
                    <!option value="science" @(string.Equals(selectedCategory, "science", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Science</!option>
                    <!option value="health" @(string.Equals(selectedCategory, "health", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Health</!option>
                    <!option value="politics" @(string.Equals(selectedCategory, "politics", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Politics</!option>
                    <!option value="world" @(string.Equals(selectedCategory, "world", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>World</!option>
                </select>
            </div>
            <div class="col-md-3 col-sm-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Fetch News</button>
                <a asp-action="LiveNews" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}
else if (!Model.IsApiKeyConfigured)
{
    <div class="alert alert-info" role="alert">
        To fetch live news from Currents API, please enter your free API key in <code>appsettings.json</code>:
        <pre class="mt-2 mb-0"><code>"CurrentsApi": {
    "BaseUrl": "https://api.currentsapi.services/",
    "ApiKey": "YOUR_API_KEY_HERE"
}</code></pre>
    </div>
}
else if (!Model.Articles.Any())
{
    <div class="alert alert-info" role="alert">
        No news articles found for the given criteria. Click <strong>Fetch News</strong> to query the latest headlines.
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Fetched Headlines</h4>
        <span class="badge bg-primary">@Model.Articles.Count Articles Returned</span>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 80px;">Image</th>
                <th>Title</th>
                <th>Category</th>
                <th>Author</th>
                <th>Published</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Articles)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.Image))
                        {
                            <img src="@item.Image" alt="@item.Title" style="width: 70px; height: 50px; object-fit: cover;" class="rounded" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=100';" />
                        }
                        else
                        {
                            <span class="badge bg-light text-muted border">No image</span>
                        }
                    </td>
                    <td>
                        <strong>@item.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="text-muted small text-truncate" style="max-width: 450px;">
                                @item.Description
                            </div>
                        }
                    </td>
                    <td>
                        <span class="badge bg-secondary">@(string.IsNullOrWhiteSpace(item.Category) ? "General" : item.Category)</span>
                    </td>
                    <td class="text-nowrap small text-muted">
                        @(string.IsNullOrWhiteSpace(item.Author) ? "Staff" : item.Author)
                    </td>
                    <td class="text-nowrap small text-muted">
                        @(item.Published.HasValue ? item.Published.Value.ToString("yyyy-MM-dd HH:mm") : "Recent")
                    </td>
                    <td class="text-end text-nowrap">
                        @if (!string.IsNullOrWhiteSpace(item.Url))
                        {
                            <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm">
                                View Story &rarr;
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
