@model NewsWebApp.Models.Author
@{
    ViewData["Title"] = $"Details - {Model.DisplayName}";
}

<h1>Details</h1>

<div>
    <h4>Author</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Avatar
        </dt>
        <dd class="col-sm-10">
            <img src="@(string.IsNullOrEmpty(Model.ProfileImageUrl) ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" : Model.ProfileImageUrl)"
                 alt="@Model.DisplayName"
                 class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" />
        </dd>
        <dt class="col-sm-2">
            Name
        </dt>
        <dd class="col-sm-10">
            @Model.DisplayName
        </dd>
        <dt class="col-sm-2">
            Bio
        </dt>
        <dd class="col-sm-10">
            @(Model.Bio ?? "Senior staff correspondent.")
        </dd>
        <dt class="col-sm-2">
            Articles Count
        </dt>
        <dd class="col-sm-10">
            @Model.NewsArticles.Count
        </dd>
    </dl>
</div>

<div class="mt-4">
    <h4>Articles by @Model.DisplayName</h4>
    <hr />
    @if (!Model.NewsArticles.Any())
    {
        <p class="text-muted">No published articles available by this author.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Published Date</th>
                    <th>Views</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in Model.NewsArticles)
                {
                    <tr>
                        <td>
                            <strong>@article.Title</strong>
                            <div class="text-muted small">@article.Summary</div>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@article.Category?.Name</span>
                        </td>
                        <td>
                            @(article.PublishedDate?.ToString("MMM dd, yyyy") ?? "Recent")
                        </td>
                        <td>
                            @article.ViewCount
                        </td>
                        <td class="text-end">
                            <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-outline-primary btn-sm">Read</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
