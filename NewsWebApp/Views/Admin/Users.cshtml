@model IEnumerable<(NewsWebApp.Models.ApplicationUser User, IList<string> Roles)>
@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<partial name="_AdminNav" />

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Created Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@item.User.FullName</strong>
                </td>
                <td>
                    <code>@item.User.Email</code>
                </td>
                <td>
                    @foreach (var role in item.Roles)
                    {
                        <span class="badge @(role == "Admin" ? "bg-danger" : role == "Author" ? "bg-primary" : "bg-secondary")">
                            @role
                        </span>
                    }
                </td>
                <td class="text-muted small">
                    @item.User.CreatedAt.ToString("yyyy-MM-dd")
                </td>
            </tr>
        }
    </tbody>
</table>
