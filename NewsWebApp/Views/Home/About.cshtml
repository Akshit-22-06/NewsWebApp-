@{
    ViewData["Title"] = "About NewsBase";
}

<div class="container my-4" style="max-width: 860px;">
    <div class="mb-4 pb-2 border-bottom">
        <h1 class="editorial-headline h2 mb-1">About NewsBase</h1>
        <p class="text-muted small mb-0">Independent Journalism &bull; Ethical Verification &bull; Global Wire Digests</p>
    </div>

    <div class="editorial-body">
        <p class="lead">
            NewsBase is a digital journalism platform engineered for high-integrity news reporting, in-depth feature commentary, and curated global news wire feeds.
        </p>

        <h4 class="h5 font-serif mt-4 mb-2">Our Editorial Mission</h4>
        <p>
            Founded on the principle that informed public discourse requires fearless, non-sensationalized reporting, NewsBase covers world affairs, science, enterprise technology, environmental policy, and economics with rigorous impartiality.
        </p>

        <h4 class="h5 font-serif mt-4 mb-2">Automated Editorial Moderation</h4>
        <p>
            To maintain respectful community discourse and editorial quality, our publishing pipeline incorporates Google Gemini AI automated evaluation. Submissions are screened in real-time for profanity, hate speech, harassment, spam, and structural quality, providing immediate actionable guidance to contributing authors while ensuring approved stories meet high standards before public release.
        </p>

        <h4 class="h5 font-serif mt-4 mb-2">Technical Foundation</h4>
        <p>
            NewsBase is built on a modern ASP.NET Core MVC architecture with Entity Framework Core, ASP.NET Core Identity authentication, SQLite relational database persistence, and Currents API news wire integration.
        </p>

        <div class="mt-4 pt-3 border-top d-flex gap-2">
            <a asp-controller="News" asp-action="Index" class="btn btn-editorial-primary btn-sm px-3">Browse News</a>
            <a asp-controller="Author" asp-action="Index" class="btn btn-editorial-outline btn-sm px-3">Meet Our Journalists</a>
        </div>
    </div>
</div>
