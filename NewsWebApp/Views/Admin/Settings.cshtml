@{
    ViewData["Title"] = "System & Editorial Settings";
}

<div class="mb-3">
    <h1 class="h2 mb-1">System &amp; Application Settings</h1>
    <p class="text-muted small mb-0">Overview of editorial services, AI moderation engine, database providers, and security configurations.</p>
</div>

<partial name="_AdminNav" />

<div class="row g-4 mb-5">
    <!-- 1. Google Gemini AI Engine Configuration -->
    <div class="col-lg-6">
        <div class="card card-editorial h-100 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold font-serif">
                    <i class="bi bi-cpu text-primary me-2"></i>Gemini AI Editorial Moderation
                </h5>
                <span class="badge @(ViewBag.HasGeminiKey ? "bg-success" : "bg-danger")">
                    @(ViewBag.HasGeminiKey ? "Connected" : "Key Missing")
                </span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Active Model:</dt>
                    <dd class="col-sm-7 fw-bold"><code>@ViewBag.GeminiModel</code></dd>

                    <dt class="col-sm-5 text-muted">API Endpoint:</dt>
                    <dd class="col-sm-7"><code>v1beta/models/@ViewBag.GeminiModel:generateContent</code></dd>

                    <dt class="col-sm-5 text-muted">Timeout Duration:</dt>
                    <dd class="col-sm-7">@ViewBag.GeminiTimeout seconds</dd>

                    <dt class="col-sm-5 text-muted">Min Passing Quality:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-secondary">@ViewBag.GeminiMinScore / 100</span>
                    </dd>

                    <dt class="col-sm-5 text-muted">Fail-Safe Policy:</dt>
                    <dd class="col-sm-7 text-success">
                        <i class="bi bi-shield-check me-1"></i>Fail-Closed (Never auto-publish without passing AI review)
                    </dd>

                    <dt class="col-sm-5 text-muted">Secret Storage:</dt>
                    <dd class="col-sm-7">.NET Secret Manager (UserSecrets)</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- 2. Currents News Wire Configuration -->
    <div class="col-lg-6">
        <div class="card card-editorial h-100 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold font-serif">
                    <i class="bi bi-broadcast text-info me-2"></i>Currents API Live News Wire
                </h5>
                <span class="badge @(ViewBag.HasCurrentsKey ? "bg-success" : "bg-warning text-dark")">
                    @(ViewBag.HasCurrentsKey ? "Configured" : "Key Optional")
                </span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Provider Base URL:</dt>
                    <dd class="col-sm-7"><code>https://api.currentsapi.services/</code></dd>

                    <dt class="col-sm-5 text-muted">Request Timeout:</dt>
                    <dd class="col-sm-7">15 seconds</dd>

                    <dt class="col-sm-5 text-muted">Fallback Strategy:</dt>
                    <dd class="col-sm-7 text-muted">Seamlessly serve local database articles if wire fails</dd>

                    <dt class="col-sm-5 text-muted">Supported Feeds:</dt>
                    <dd class="col-sm-7">Latest News, Category Search, Multi-lingual (English, Hindi, Spanish)</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- 3. Database & Entity Framework Configuration -->
    <div class="col-lg-6">
        <div class="card card-editorial h-100 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 fw-bold font-serif">
                    <i class="bi bi-database text-secondary me-2"></i>Database &amp; Storage Engine
                </h5>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Provider:</dt>
                    <dd class="col-sm-7 fw-bold"><code>@ViewBag.DatabaseProvider</code> (SQLite EF Core 10.0)</dd>

                    <dt class="col-sm-5 text-muted">Database File:</dt>
                    <dd class="col-sm-7"><code>newswebapp.db</code></dd>

                    <dt class="col-sm-5 text-muted">Migration State:</dt>
                    <dd class="col-sm-7 text-success">
                        <i class="bi bi-check2-all me-1"></i>Synchronized (5 Applied Migrations)
                    </dd>

                    <dt class="col-sm-5 text-muted">Audit Fields:</dt>
                    <dd class="col-sm-7">Quality Score, Detected Categories, Model Version, Moderated Timestamp</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- 4. Security & Identity Policies -->
    <div class="col-lg-6">
        <div class="card card-editorial h-100 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 fw-bold font-serif">
                    <i class="bi bi-shield-lock text-dark me-2"></i>Security &amp; Authentication
                </h5>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Authentication:</dt>
                    <dd class="col-sm-7">ASP.NET Core Identity (HttpOnly Cookies, Sliding 14-day expiry)</dd>

                    <dt class="col-sm-5 text-muted">CSRF Protection:</dt>
                    <dd class="col-sm-7 text-success">
                        <i class="bi bi-shield-check me-1"></i>ValidateAntiForgeryToken enforced on all POST forms
                    </dd>

                    <dt class="col-sm-5 text-muted">Password Policy:</dt>
                    <dd class="col-sm-7">6+ chars, upper, lower, digit, non-alphanumeric</dd>

                    <dt class="col-sm-5 text-muted">Role Hierarchy:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-danger me-1">Admin</span>
                        <span class="badge bg-primary me-1">Author</span>
                        <span class="badge bg-secondary">Reader</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>
