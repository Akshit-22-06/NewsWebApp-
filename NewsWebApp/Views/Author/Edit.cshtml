@model NewsWebApp.ViewModels.EditAuthorArticleViewModel
@{
    ViewData["Title"] = "Edit Article - Author Studio";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h1 class="h2 mb-1">Edit Article</h1>
                <p class="text-muted mb-0">Revise your article content and resubmit for Gemini AI automated editorial review.</p>
            </div>
            <div>
                <a asp-controller="Author" asp-action="Dashboard" class="btn btn-outline-secondary">
                    Back to Studio
                </a>
            </div>
        </div>

        @if (Model.Status == NewsWebApp.Models.ArticleStatus.Rejected && !string.IsNullOrWhiteSpace(Model.RejectionReason))
        {
            <div class="alert alert-danger mb-4 shadow-sm" role="alert">
                <div class="d-flex align-items-center mb-1">
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-4 me-2"></i>
                    <h5 class="alert-heading fw-bold mb-0">Article Did Not Pass AI Editorial Review</h5>
                </div>
                <p class="mb-2 mt-2"><strong>AI Feedback &amp; Guidelines:</strong> @Model.RejectionReason</p>
                <hr />
                <small class="mb-0 text-muted">Please update your article to address the points above, then click <strong>"Resubmit for AI Review"</strong> below. If your revised article passes, it will be published immediately.</small>
            </div>
        }
        else if (Model.Status == NewsWebApp.Models.ArticleStatus.Pending)
        {
            <div class="alert alert-warning mb-4 shadow-sm" role="alert">
                <strong>Status: Pending Review.</strong> You can make edits while it is waiting for review.
            </div>
        }
        else if (Model.Status == NewsWebApp.Models.ArticleStatus.Approved)
        {
            <div class="alert alert-info mb-4 shadow-sm" role="alert">
                <strong>Status: Approved.</strong> Notice: Saving changes to this approved article will automatically run Gemini AI review on your new edits before updates go live.
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form id="articleEditForm" asp-controller="Author" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Article Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-lg" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="">-- Choose Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label fw-semibold">Featured Image URL (Optional)</label>
                        <input asp-for="ImageUrl" class="form-control" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <!-- Summary -->
                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fw-semibold">Summary / Subheading <span class="text-danger">*</span></label>
                        <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Summary" class="text-danger small"></span>
                    </div>

                    <!-- Content -->
                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold">Article Body <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" class="form-control" rows="12"></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>

                    <!-- Loading Status Indicator -->
                    <div id="aiReviewLoadingBanner" class="alert alert-info py-2 px-3 mb-3 d-none align-items-center">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        <div><strong>Re-evaluating updated article with Gemini AI...</strong> Please wait a moment.</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-controller="Author" asp-action="Dashboard" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" id="btnEditSubmit" class="btn btn-primary px-4">
                            <span id="btnEditSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true"></span>
                            <span id="btnEditText">@(Model.Status == NewsWebApp.Models.ArticleStatus.Rejected ? "Resubmit for Review" : "Save Changes")</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('articleEditForm');
            const submitBtn = document.getElementById('btnEditSubmit');
            const submitSpinner = document.getElementById('btnEditSpinner');
            const submitText = document.getElementById('btnEditText');
            const loadingBanner = document.getElementById('aiReviewLoadingBanner');

            if (form && submitBtn) {
                form.addEventListener('submit', function (e) {
                    if (window.jQuery && !$(form).valid()) {
                        return;
                    }

                    submitBtn.disabled = true;
                    submitSpinner.classList.remove('d-none');
                    submitText.textContent = 'Reviewing with Gemini AI...';
                    if (loadingBanner) {
                        loadingBanner.classList.remove('d-none');
                        loadingBanner.classList.add('d-flex');
                    }
                });
            }
        });
    </script>
}
