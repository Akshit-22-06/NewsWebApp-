@model NewsWebApp.ViewModels.CityNewsViewModel

@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.City) ? "City & Local Area News" : $"{Model.City} News - Latest Local Headlines";
}

<div class="row mb-4">
    <div class="col-md-12">
        <h1 class="display-6">📍 City &amp; Local Area News</h1>
        <p class="text-muted">
            Enter your city, district, or hometown name to get real-time, live local breaking news.
        </p>

        <!-- City Search Bar -->
        <div class="card bg-light border-0 shadow-sm mb-4">
            <div class="card-body">
                <form asp-controller="News" asp-action="City" method="get" class="row g-2 align-items-center">
                    <div class="col-md-9 col-sm-8">
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-geo-alt"></i> City / Area</span>
                            <input type="text" name="city" value="@Model.City" class="form-control form-control-lg" 
                                   placeholder="Enter any city name (e.g. Pune, Jaipur, Lucknow, Chandigarh, Ahmedabad, Patna)..." required />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-4">
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Search City News
                        </button>
                    </div>
                </form>

                <!-- Popular Cities Quick Badges -->
                <div class="mt-3">
                    <span class="text-muted small fw-bold me-2">Quick Cities:</span>
                    @foreach (var c in Model.PopularCities)
                    {
                        <a asp-action="City" asp-route-city="@c" 
                           class="btn btn-sm @(string.Equals(Model.City, c, StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary") me-1 mb-1">
                            @c
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.City))
{
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h3 class="mb-0">
                Latest News for <span class="text-primary">@Model.City</span>
            </h3>
            <p class="text-muted small mb-0">
                Showing @Model.TotalFound live articles and regional updates for @Model.City.
                @if (Model.IsLiveFetched)
                {
                    <span class="badge bg-success ms-1">Just Synced from Live Wire</span>
                }
            </p>
        </div>
        <form asp-controller="News" asp-action="RefreshCity" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="city" value="@Model.City" />
            <button type="submit" class="btn btn-outline-primary btn-sm">
                🔄 Refresh Live News for @Model.City
            </button>
        </form>
    </div>

    @if (Model.Articles.Any())
    {
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Headline</th>
                    <th>City / Region</th>
                    <th>Source</th>
                    <th>Category</th>
                    <th>Published</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Articles)
                {
                    <tr>
                        <td>
                            <a asp-controller="News" asp-action="Details" asp-route-slug="@item.Slug" class="fw-bold text-decoration-none">
                                @item.Title
                            </a>
                            @if (item.IsLiveSynced)
                            {
                                <span class="badge bg-danger ms-1">Live</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">@(string.IsNullOrEmpty(item.Region) ? Model.City : item.Region)</span>
                        </td>
                        <td>
                            @(item.SourceName ?? "City Wire")
                        </td>
                        <td>
                            <span class="badge bg-secondary">@item.Category?.Name</span>
                        </td>
                        <td class="small text-nowrap">
                            @if (item.PublishedDate.HasValue)
                            {
                                var diff = DateTime.UtcNow - item.PublishedDate.Value;
                                if (diff.TotalMinutes < 60 && diff.TotalMinutes >= 0)
                                {
                                    <span class="badge bg-success">Just now</span>
                                }
                                else if (diff.TotalHours < 24 && diff.TotalHours >= 0)
                                {
                                    <span class="badge bg-primary">@($"{(int)diff.TotalHours}h ago")</span>
                                }
                                else if (diff.TotalDays < 2 && diff.TotalDays >= 0)
                                {
                                    <span class="badge bg-secondary">Yesterday</span>
                                }
                                else
                                {
                                    <span class="text-muted">@item.PublishedDate.Value.ToString("MMM dd, yyyy")</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Recent</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="News" asp-action="Details" asp-route-slug="@item.Slug" class="btn btn-sm btn-outline-primary">
                                Details
                            </a>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="News" asp-action="ToggleBookmark" asp-route-id="@item.Id" method="post" class="d-inline ms-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Save to bookmarks">
                                        Bookmark
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-sm btn-outline-secondary" title="Login to bookmark">
                                    Bookmark
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            <h5>No news found for "@Model.City" yet.</h5>
            <p class="mb-0">
                Try clicking <strong>🔄 Refresh Live News for @Model.City</strong> above or search for another nearby district or state.
            </p>
        </div>
    }
}
else
{
    <div class="card text-center p-5 border-0 bg-light">
        <div class="card-body">
            <h3 class="card-title text-muted mb-3">📍 Enter Your City to View Local News</h3>
            <p class="card-text text-muted mx-auto" style="max-width: 600px;">
                Our platform connects to real-time regional and city news APIs across India and worldwide. 
                Type any city name like <strong>Pune</strong>, <strong>Jaipur</strong>, <strong>Lucknow</strong>, <strong>Chandigarh</strong>, or <strong>Ahmedabad</strong> above to explore local headlines!
            </p>
        </div>
    </div>
}
