@model IEnumerable<NewsWebApp.Models.NewsArticle>
@{
    ViewData["Title"] = "Manage Articles";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    string? search = ViewBag.Search as string;
    int? categoryId = ViewBag.CategoryId as int?;
    bool? isPublished = ViewBag.IsPublished as bool?;
    string? status = ViewBag.Status as string;
    var categories = ViewBag.Categories as IEnumerable<NewsWebApp.Models.Category> ?? Enumerable.Empty<NewsWebApp.Models.Category>();
    var pendingArticles = ViewBag.PendingArticles as IEnumerable<NewsWebApp.Models.NewsArticle> ?? Enumerable.Empty<NewsWebApp.Models.NewsArticle>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Articles Management</h1>
    <a asp-action="CreateArticle" class="btn btn-primary">+ Create New Article</a>
</div>

<partial name="_AdminNav" />

<!-- PENDING REVIEW SECTION -->
@if (pendingArticles.Any())
{
    <div class="card border-warning shadow-sm mb-4">
        <div class="card-header bg-warning bg-opacity-25 py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                Pending Review (@pendingArticles.Count())
            </h5>
            <span class="badge bg-warning text-dark">Requires Moderation</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 250px;">Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Submitted</th>
                        <th class="text-end" style="min-width: 240px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pending in pendingArticles)
                    {
                        <tr>
                            <td>
                                <a asp-action="ReviewArticle" asp-route-id="@pending.Id" class="fw-bold text-decoration-none">
                                    @pending.Title
                                </a>
                                <div class="text-muted small">Slug: <code>@pending.Slug</code></div>
                            </td>
                            <td>
                                <strong>@(pending.Author?.DisplayName ?? "Staff")</strong>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@(pending.Category?.Name ?? "General")</span>
                            </td>
                            <td class="text-muted small">
                                @pending.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="ReviewArticle" asp-route-id="@pending.Id" class="btn btn-sm btn-outline-info">
                                    View
                                </a>

                                <form asp-action="ApproveArticle" asp-route-id="@pending.Id" method="post" class="d-inline" onsubmit="return confirm('Approve this article and publish it?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">
                                        Approve
                                    </button>
                                </form>

                                <a asp-action="ReviewArticle" asp-route-id="@pending.Id" class="btn btn-sm btn-outline-danger">
                                    Reject
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-light border py-2 px-3 mb-4 d-flex justify-content-between align-items-center">
        <span class="text-muted small">No articles currently pending review.</span>
        <span class="badge bg-success">Queue Clear</span>
    </div>
}

<!-- FILTER TOOLBAR -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-controller="Admin" asp-action="Articles" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold" for="search">Title Search</label>
                <input type="text" id="search" name="search" value="@search" placeholder="Search keywords..." class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold" for="categoryId">Category</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id" selected="@(categoryId == c.Id ? "selected" : null)">
                            @c.Name
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold" for="status">Review Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(status == "Pending" ? "selected" : null)">Pending</option>
                    <option value="Approved" selected="@(status == "Approved" ? "selected" : null)">Approved</option>
                    <option value="Rejected" selected="@(status == "Rejected" ? "selected" : null)">Rejected</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold" for="isPublished">Visibility</label>
                <select id="isPublished" name="isPublished" class="form-select">
                    <option value="">All</option>
                    <option value="true" selected="@(isPublished == true ? "selected" : null)">Published</option>
                    <option value="false" selected="@(isPublished == false ? "selected" : null)">Hidden / Draft</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-controller="Admin" asp-action="Articles" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- ALL ARTICLES TABLE -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">All Articles (@totalCount)</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 250px;">Title</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Status</th>
                    <th>Live</th>
                    <th>Featured</th>
                    <th>Created</th>
                    <th class="text-end" style="min-width: 190px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            No articles found matching the filter criteria.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="ReviewArticle" asp-route-id="@item.Id" class="fw-bold text-decoration-none">
                                @(item.Title.Length > 55 ? item.Title.Substring(0, 55) + "..." : item.Title)
                            </a>
                            <div class="text-muted small">
                                Slug: <code>@item.Slug</code>
                            </div>
                            @if (item.Status == NewsWebApp.Models.ArticleStatus.Rejected && !string.IsNullOrWhiteSpace(item.RejectionReason))
                            {
                                <div class="text-danger small mt-1">
                                    <strong>Rejection:</strong> @item.RejectionReason
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary">@(item.Category?.Name ?? "General")</span>
                        </td>
                        <td>
                            @(item.Author?.DisplayName ?? "Staff")
                        </td>
                        <td>
                            @if (item.Status == NewsWebApp.Models.ArticleStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (item.Status == NewsWebApp.Models.ArticleStatus.Rejected)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td>
                            <form asp-controller="Admin" asp-action="TogglePublish" asp-route-id="@item.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (item.IsPublished)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Click to unpublish">
                                        Published
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Click to publish">
                                        Hidden
                                    </button>
                                }
                            </form>
                        </td>
                        <td>
                            <form asp-controller="Admin" asp-action="ToggleFeatured" asp-route-id="@item.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (item.IsFeatured)
                                {
                                    <button type="submit" class="btn btn-sm btn-primary" title="Click to remove featured">
                                        Yes
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Click to make featured">
                                        No
                                    </button>
                                }
                            </form>
                        </td>
                        <td class="small text-muted">
                            @item.CreatedAt.ToString("yyyy-MM-dd")
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="ReviewArticle" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">Review</a>
                            <a asp-action="EditArticle" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                            <a asp-action="DeleteArticle" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- PAGINATION -->
@if (totalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage > 1 ? "" : "disabled")">
                <a class="page-link"
                   asp-controller="Admin"
                   asp-action="Articles"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-search="@search"
                   asp-route-categoryId="@categoryId"
                   asp-route-status="@status"
                   asp-route-isPublished="@isPublished">
                    Previous
                </a>
            </li>

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link"
                       asp-controller="Admin"
                       asp-action="Articles"
                       asp-route-page="@p"
                       asp-route-search="@search"
                       asp-route-categoryId="@categoryId"
                       asp-route-status="@status"
                       asp-route-isPublished="@isPublished">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(currentPage < totalPages ? "" : "disabled")">
                <a class="page-link"
                   asp-controller="Admin"
                   asp-action="Articles"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-search="@search"
                   asp-route-categoryId="@categoryId"
                   asp-route-status="@status"
                   asp-route-isPublished="@isPublished">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}
