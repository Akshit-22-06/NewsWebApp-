@model List<NewsWebApp.Models.NewsDto>

@{
    ViewData["Title"] = "News Articles";
    var searchTerm = ViewBag.SearchTerm as string;
    var selectedCategory = ViewBag.SelectedCategory as string;
    var selectedCountry = ViewBag.SelectedCountry as string;
    var selectedLanguage = ViewBag.SelectedLanguage as string;
    var errorMessage = ViewBag.ErrorMessage as string;
}

<div class="mb-3">
    <h1 class="mb-0">News Articles</h1>
</div>

<!-- Search and Filter Form -->
<div class="row mb-4">
    <div class="col-md-12">
        <form asp-controller="News" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-3 col-sm-6">
                <input type="text" name="search" value="@searchTerm" class="form-control" placeholder="Search keywords..." />
            </div>
            <div class="col-md-3 col-sm-6">
                <select name="category" class="form-select">
                    <option value="">All Categories</option>
                    <!option value="technology" @(string.Equals(selectedCategory, "technology", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Technology</!option>
                    <!option value="business" @(string.Equals(selectedCategory, "business", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Business</!option>
                    <!option value="sports" @(string.Equals(selectedCategory, "sports", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Sports</!option>
                    <!option value="entertainment" @(string.Equals(selectedCategory, "entertainment", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Entertainment</!option>
                    <!option value="science" @(string.Equals(selectedCategory, "science", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Science</!option>
                    <!option value="health" @(string.Equals(selectedCategory, "health", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Health</!option>
                    <!option value="politics" @(string.Equals(selectedCategory, "politics", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Politics</!option>
                    <!option value="world" @(string.Equals(selectedCategory, "world", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>World</!option>
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <select name="country" class="form-select">
                    <option value="">All Countries</option>
                    <!option value="IN" @(string.Equals(selectedCountry, "IN", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>India</!option>
                    <!option value="US" @(string.Equals(selectedCountry, "US", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>United States</!option>
                    <!option value="GB" @(string.Equals(selectedCountry, "GB", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>United Kingdom</!option>
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <select name="language" class="form-select">
                    <option value="">All Languages</option>
                    <!option value="en" @(string.Equals(selectedLanguage, "en", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>English</!option>
                    <!option value="hi" @(string.Equals(selectedLanguage, "hi", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Hindi</!option>
                    <!option value="es" @(string.Equals(selectedLanguage, "es", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Spanish</!option>
                </select>
            </div>
            <div class="col-md-2 col-sm-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning" role="alert">
        @errorMessage
    </div>
}
else if (Model == null || !Model.Any())
{
    <div class="alert alert-info" role="alert">
        No news articles found.
    </div>
}
else
{
    <p class="text-muted">Showing @Model.Count articles</p>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(item.Image))
                    {
                        <img src="@item.Image" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=800';" />
                    }
                    else
                    {
                        <img src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=800" class="card-img-top" alt="Placeholder news image" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            @if (!string.IsNullOrWhiteSpace(item.Category))
                            {
                                <span class="badge bg-secondary">@item.Category</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Language))
                            {
                                <span class="badge bg-light text-dark border">@item.Language.ToUpper()</span>
                            }
                        </div>
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted flex-grow-1">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                        </p>
                        <div class="text-muted small mb-3">
                            <div><strong>Author:</strong> @(string.IsNullOrWhiteSpace(item.Author) ? "Staff" : item.Author)</div>
                            <div><strong>Published:</strong> @(item.Published.HasValue ? item.Published.Value.ToString("yyyy-MM-dd HH:mm") : "Recently")</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Url))
                        {
                            <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm mt-auto">
                                Read Article &rarr;
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
